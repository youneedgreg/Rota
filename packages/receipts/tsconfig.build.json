{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    // TextDecoder: global in browsers and in Node since v11.
    "lib": ["ES2022", "DOM"],
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "src/test-invoice.ts"]
}
