# Copy to .env.local and fill in your own values. Never commit real values.
# Every value below is fake.

# Nostr relay the app publishes signed, encrypted receipts to (local strfry by default).
NEXT_PUBLIC_RELAY_URL=ws://localhost:7777

# Built-in wallet (Breez SDK, Spark), running in the member's browser.
# "mainnet" (the demo) or "regtest" (Lightspark's free test network: no key
# needed, coins have no value, and no Lightning payments).
NEXT_PUBLIC_BREEZ_NETWORK=mainnet
# Breez API key, required on mainnet. It is inlined into the browser bundle,
# so anyone can read it, including the email address it was issued to.
# Request your own from Breez.
NEXT_PUBLIC_BREEZ_API_KEY=fake-breez-api-key

# Error reports to Sentry, from the browser. Leave empty to turn them off.
# A DSN is public by design (it ships in the page). Reports are scrubbed on the
# phone before sending: no URLs' # or ? parts, no addresses, numbers,
# invoices or keys. Also turn on data scrubbing in the Sentry project.
NEXT_PUBLIC_SENTRY_DSN=
