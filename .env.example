# Copy to .env.local and fill in your own values. Never commit real values.
# Every value below is fake.

# Nostr relay the app publishes signed, encrypted receipts to (local strfry by default).
NEXT_PUBLIC_RELAY_URL=ws://localhost:7777

# Breez SDK (Spark) API key for the built-in wallet. Requested from Breez; emailed.
# Where it must live (server or browser) is checked before the wallet is built.
BREEZ_API_KEY=fake-breez-api-key

# Error tracking, with data scrubbing on. Leave empty to turn it off.
SENTRY_DSN=
